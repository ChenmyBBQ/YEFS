{
    "chat.includeApplyingInstructions": true,
    "chat.includeReferencedInstructions": true,
    "chat.useAgentsMdFile": true,
    "chat.useClaudeMdFile": true,
    "chat.instructionsFilesLocations": {
        ".github/instructions": true,
        "~/.copilot/instructions": false,
        ".claude/rules": false,
        "~/.claude/rules": false
    },
    "qt.qml.importPaths": [
        "${workspaceFolder}/out/RelWithDebInfo/bin",
        "${workspaceFolder}/3rdparty/HuskarUI/src/imports",
        "${workspaceFolder}/3rdparty/HuskarUI/build/HuskarUI/qml"
    ],
    "qml.importPaths": [
        "${workspaceFolder}/out/RelWithDebInfo/bin",
        "${workspaceFolder}/3rdparty/HuskarUI/src/imports",
        "${workspaceFolder}/3rdparty/HuskarUI/build/HuskarUI/qml"
    ],
    "qt-qml.qmlls.additionalImportPaths": [
        "${workspaceFolder}/out/RelWithDebInfo/bin",
        "${workspaceFolder}/build/src"
    ],
    "qt-qml.qmlls.useNoCMakeCalls": false,
    "chat.tools.terminal.autoApprove": {
        "Tee-Object": true
    },
    "markdown.validate.enabled": false
}